# Sony α7C II QEMU 模拟器配置文件（由 ./start.sh 自动加载）
#
# 说明：
#   1. 直接编辑本文件即可调整默认启动配置，无需向 ./start.sh 传入命令行参数。
#   2. 若在启动前通过 shell 显式导出了同名环境变量（例如 A7C2_VERIFY_SHA=1 ./start.sh），
#      shell 中的值优先于本文件；也可用 A7C2_ENV_FILE=/path/to/custom.env 指定其他配置文件。
#   3. 常用功能（相机 USB 设备、省电自动唤醒、虚拟镜头 HUD/拍摄、RAM 快照会话、SD 热插拔、
#      CMOS 画面源等）均可在图形界面中直接开关。

# ---- 启动路线与完整性检查 ----
# 启动路线：original-init-cold（默认，完整原厂 kernel→init→init2→appFw）或 direct-bootin（兼容路线）
A7C2_BOOT_PROFILE=original-init-cold

# 虚拟加载器对 p5 WBI2 标志的处理：force（默认，强制冷启动）/ clear（备份并清除）/ strict（严格模式）
A7C2_COLD_FLAG=force

# 启动前是否执行全量 SHA256 校验：0（默认，快速启动）/ 1（完整校验）
A7C2_VERIFY_SHA=0

# 是否启用内部持久磁盘（original-init-cold 路线固定需要启用；direct-bootin 可设为 0）
A7C2_USE_PERSISTENT_STORAGE=1

# 仅准备/校验官方固件资产，不启动 UI 与 VM：0（默认）/ 1
A7C2_PREPARE_ONLY=0

# ---- 默认启用的核心功能（亦可在 UI 中开关） ----
# 相机 USB 设备端点模型（「连接电脑」功能）：1（默认开启）/ 0（关闭）
# 注意：相机 USB 设备与 QEMU RAM 快照会话互斥，在 UI 中启用其中一个时会自动关闭另一个。
A7C2_ENABLE_USB_DEVICE=1

# 可选：显式指定已构建的 usb-device-build.json 收据路径；留空则自动选用 source/build/ 下最新已验证构建
A7C2_USB_DEVICE_BUILD=

# QEMU RAM 快照会话（保存/恢复整机内存状态）：0（默认关闭，以优先启用 USB 设备）/ 1（启动即启用，并自动关闭 USB 设备）
A7C2_RAM_MODE=0

# 自动省电关机（APO1）按任意键唤醒 + 操作时自动重置 60 秒省电计时：1（默认开启）/ 0（关闭）
A7C2_AUTO_WAKE=1

# 软件虚拟镜头 HUD、A/S/M/P 拨盘曝光参数与软件 CMOS 拍照/原厂回放：1（默认开启）/ 0（关闭）
A7C2_VIRTUAL_LENS_HUD=1

# 虚拟蓝牙 / HCI ROM：virtual-rom-v1（默认开启）；留空表示禁用
A7C2_VIRTUAL_HCI=virtual-rom-v1

# ---- 可选输入与高级路径覆盖（留空使用包内默认路径） ----
# 官方固件包 BODYDATA.DAT 的文件路径或所在目录；留空自动查找 incoming/bodydata/BODYDATA.DAT
A7C2_BODYDATA=

# 可选：覆盖 guest 文件的目录路径（例如自定义测试库）
A7C2_OVERWRITE_DIR=

# 可选：外部虚拟 FAT SD 镜像文件路径（仅接受普通文件，不接受物理设备）
A7C2_SD_IMAGE=

# 可选高级路径覆盖（一般无需修改）
# A7C2_CACHE_DIR=
# A7C2_FWTOOL_DIR=
# A7C2_RUNTIME_DIR=
# A7C2_RUNTIME_ANALYSIS_DIR=
