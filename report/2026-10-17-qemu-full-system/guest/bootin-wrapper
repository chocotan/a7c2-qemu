#!/bin/busybox sh
# Default entry is bind-mounted; p15 experiments call this adapter after their own handoff.
original_elf=/simulation/bootin-original
case "${1-}" in
    --original-elf)
        case " $(cat /proc/cmdline) " in
            *" fullsystem.bootin-handoff=p15-wrapper "*) ;;
            *) echo FULLSYSTEM_BOOTIN_HANDOFF_FAILED profile; exit 1;;
        esac
        case "${2-}" in
            /usr/bin/bootin-original|/log/a7c2/bootin-original) original_elf=$2;;
            *) echo FULLSYSTEM_BOOTIN_HANDOFF_FAILED path; exit 1;;
        esac
        shift 2
        [ -f "$original_elf" ] && [ -x "$original_elf" ] || {
            echo FULLSYSTEM_BOOTIN_HANDOFF_FAILED executable; exit 1;
        }
        original_elf_sha256=dab3ce4b6c28a6c9ffd9f0b893dce1d08f3ee7302a09df87e518409e728be2f2
        original_elf_digest=$(/usr/bin/openssl dgst -sha256 "$original_elf") || {
            echo FULLSYSTEM_BOOTIN_HANDOFF_FAILED digest; exit 1;
        }
        case "$original_elf_digest" in
            "SHA256($original_elf)= $original_elf_sha256"|"SHA2-256($original_elf)= $original_elf_sha256") ;;
            *) echo FULLSYSTEM_BOOTIN_HANDOFF_FAILED sha256; exit 1;;
        esac
        ;;
esac
unset FULLSYSTEM_USB_TOUCH
unset MENU_TOUCH_PANEL
unset MENU_TCIN_DETECT
usb_touch_count=0
usb_touch_mode=
for touch_token in $(cat /proc/cmdline); do
    case "$touch_token" in
        fullsystem.usb-touch=*)
            [ "$usb_touch_count" = 0 ] || { echo FULLSYSTEM_USB_TOUCH_DUPLICATE; exit 1; }
            usb_touch_count=1; usb_touch_mode=${touch_token#*=};;
    esac
done
case "$usb_touch_count:$usb_touch_mode" in
    0:) ;;
    1:virtual-config-v1|1:virtual-config-tcin-inactive-v1)
        case " $(cat /proc/cmdline) " in
            *" fullsystem.usb-service=original-sen-observe-v1 "*) ;;
            *) echo FULLSYSTEM_USB_TOUCH_REQUIRES_SERVICE; exit 1;;
        esac
        touch_digest=$(/usr/bin/openssl dgst -sha256 /usr/lib/appFw.so) || exit 1
        case "$touch_digest" in
            "SHA256(/usr/lib/appFw.so)= 2ea02f7ecbc5bb917316fe8ef4ce5ffd87eb66efaae78ba2ce11420552df539b"|            "SHA2-256(/usr/lib/appFw.so)= 2ea02f7ecbc5bb917316fe8ef4ce5ffd87eb66efaae78ba2ce11420552df539b") ;;
            *) echo FULLSYSTEM_USB_TOUCH_APP_IDENTITY_FAILED; exit 1;;
        esac
        export FULLSYSTEM_USB_TOUCH=$usb_touch_mode
        echo FULLSYSTEM_USB_TOUCH_PROFILE=$usb_touch_mode;;
    *) echo FULLSYSTEM_USB_TOUCH_INVALID_PROFILE; exit 1;;
esac
unset FULLSYSTEM_AUDIO_SERVICE
unset FULLSYSTEM_AUDIO_CAPABILITIES
unset FULLSYSTEM_HDMI_SERVICE
unset FULLSYSTEM_LIRO_OBSERVE
unset FULLSYSTEM_VEF_SERVICE
unset FULLSYSTEM_PINMEM_SERVICE
unset FULLSYSTEM_PIN_CONNECTION
unset FULLSYSTEM_PIN_FORMAT
unset FULLSYSTEM_BACKUP_LOG
unset FULLSYSTEM_SCALAR_SERVICE
unset FULLSYSTEM_INFRABB_SERVICE
unset FULLSYSTEM_DRAWINFO_SERVICE
unset FULLSYSTEM_GRMPIN_SERVICE
unset FULLSYSTEM_OSD_IMMUTABLE
case " $(cat /proc/cmdline) " in
    *" fullsystem.osd-immutable=capture "*)
        export FULLSYSTEM_OSD_IMMUTABLE=capture
        echo FULLSYSTEM_OSD_IMMUTABLE_PROFILE=capture;;
esac
unset FULLSYSTEM_ADF_SERVICE
unset FULLSYSTEM_ADF_CONNECTION
unset FULLSYSTEM_HDMI_PIN_SERVICE
unset FULLSYSTEM_SCALAR_CONNECTION
unset FULLSYSTEM_INFRABB_CONNECTION
unset FULLSYSTEM_HDMI_CONNECTION
unset FULLSYSTEM_ADF_AUDIO_CONNECTION
unset FULLSYSTEM_DIG_LEVEL
unset FULLSYSTEM_DMM
unset FULLSYSTEM_INSMOD_POLICY
unset FULLSYSTEM_INPUT_OBSERVE
unset FULLSYSTEM_GUI_MODELS
unset FULLSYSTEM_REMOTE_STATE
case " $(cat /proc/cmdline) " in
    *" fullsystem.remote-state=capture "*) export FULLSYSTEM_REMOTE_STATE=capture;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.gui-models=capture "*) export FULLSYSTEM_GUI_MODELS=capture;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.input-observe=1 "*) export FULLSYSTEM_INPUT_OBSERVE=1;;
esac
echo FULLSYSTEM_BOOTIN_ENTER
/simulation/seed-power-on 1 || { echo FULLSYSTEM_BOOT_RECORD_FAILED; exit 1; }
case " $(cat /proc/cmdline) " in
    *" fullsystem.bluetooth=off "*)
        LD_LIBRARY_PATH=/usr/lib:/lib /simulation/bluetooth-policy off || { echo FULLSYSTEM_BLUETOOTH_POLICY_FAILED; exit 1; };;
esac
/simulation/init-clock || { echo FULLSYSTEM_CLOCK_FAILED; exit 1; }
case " $(cat /proc/cmdline) " in
    *" fullsystem.sound-owner=1 "*)
        /simulation/system-sound-owner || { echo FULLSYSTEM_SOUND_OWNER_FAILED; exit 1; }
        ;;
esac
/simulation/ramfb-viewer >/log/qemu/ramfb-viewer.log 2>&1 &
echo "FULLSYSTEM_RAMFB_PID=$!"
export LD_LIBRARY_PATH=/usr/lib:/lib
export LD_PRELOAD=/simulation/menu-observe.so
case " $(cat /proc/cmdline) " in
    *" fullsystem.file-media=card-rm "*)
        # card-rm additionally loads the ported user-space RM/media provider. It is a
        # separate profile because that provider is not stable yet (run-tdk1nnvz: it
        # refused with rc=-1 in one process while the others could not resolve the osal
        # symbols, and the firmware hit its own exception monitor). Keeping it out of
        # the plain card profile protects the path that is already verified.
        cp /simulation/media-template.fat /image_mmca || { echo FULLSYSTEM_FILE_MEDIA_SEED_FAILED; exit 1; }
        export A7C2_FILE_MEDIA_TEST=1
        export MENU_RM_FILE_IMAGE=/image_mmca
        export MENU_RM_FILE_CLAIM=/tmp/rm-file.claim
        export LD_PRELOAD=/simulation/file-media-config.so:/simulation/rm-file.so:$LD_PRELOAD
        echo FULLSYSTEM_FILE_MEDIA_PROFILE=card-rm
        ;;
    *" fullsystem.file-media=card "*)
        # Seed the guest backing file, then let the ORIGINAL media layer pick its own
        # file backend (see FILE-MEDIA-BACKEND-PORT.md). Nothing is faked: the original
        # Fsys/Mount/Open/Write code does the work.
        cp /simulation/media-template.fat /image_mmca || { echo FULLSYSTEM_FILE_MEDIA_SEED_FAILED; exit 1; }
        export A7C2_FILE_MEDIA_TEST=1
        export LD_PRELOAD=/simulation/file-media-config.so:$LD_PRELOAD
        echo FULLSYSTEM_FILE_MEDIA_PROFILE=card
        ;;
    *) echo FULLSYSTEM_FILE_MEDIA_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.detect-observe=1 "*)
        # Observation only: interposes the media-detect state machine and logs it.
        # Its own case block so it composes with any file-media profile.
        export FULLSYSTEM_DETECT_OBSERVE=1
        export LD_PRELOAD=/simulation/detect-observe.so:$LD_PRELOAD
        echo FULLSYSTEM_DETECT_OBSERVE_PROFILE=on
        ;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.backup-log=sampled "*)
        export FULLSYSTEM_BACKUP_LOG=sampled
        echo FULLSYSTEM_BACKUP_LOG_PROFILE=sampled
        ;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.liro-observe=1 "*)
        export FULLSYSTEM_LIRO_OBSERVE=1
        export LD_PRELOAD=/simulation/liro-observe.so:/simulation/menu-observe.so
        echo FULLSYSTEM_LIRO_OBSERVER=on
        ;;
esac
unset FULLSYSTEM_IMAGING_SERVICE
case " $(cat /proc/cmdline) " in
    *" fullsystem.grmpin=registry "*)
        export FULLSYSTEM_GRMPIN_SERVICE=registry
        echo FULLSYSTEM_GRMPIN_PROFILE=registry;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.drawinfo=registry "*)
        export FULLSYSTEM_DRAWINFO_SERVICE=registry
        echo FULLSYSTEM_DRAWINFO_PROFILE=registry;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.infrabb=registry "*)
        export FULLSYSTEM_INFRABB_SERVICE=registry
        echo FULLSYSTEM_INFRABB_PROFILE=registry;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.imaging=release-inhibit "*)
        export FULLSYSTEM_IMAGING_SERVICE=1
        echo FULLSYSTEM_IMAGING_PROFILE=release-inhibit
        ;;
    *) echo FULLSYSTEM_IMAGING_PROFILE=off;;
esac
unset FULLSYSTEM_VDF_SERVICE
case " $(cat /proc/cmdline) " in
    *" fullsystem.audio=boot "*)
        case " $(cat /proc/cmdline) " in
            *" fullsystem.sound-owner=1 "*) ;;
            *) echo FULLSYSTEM_AUDIO_OWNER_REQUIRED; exit 1;;
        esac
        export FULLSYSTEM_AUDIO_SERVICE=boot
        echo FULLSYSTEM_AUDIO_PROFILE=boot
        ;;
    *" fullsystem.audio=volume "*)
        export FULLSYSTEM_AUDIO_SERVICE=volume
        echo FULLSYSTEM_AUDIO_PROFILE=volume
        ;;
    *) echo FULLSYSTEM_AUDIO_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.audio-caps=inputless "*)
        case "$FULLSYSTEM_AUDIO_SERVICE" in
            boot) export FULLSYSTEM_AUDIO_CAPABILITIES=inputless;;
            *) echo FULLSYSTEM_AUDIO_CAPABILITIES_REQUIRE_BOOT; exit 1;;
        esac
        echo FULLSYSTEM_AUDIO_CAPABILITIES=inputless
        ;;
    *) echo FULLSYSTEM_AUDIO_CAPABILITIES=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.vdf=timecode "*)
        export FULLSYSTEM_VDF_SERVICE=timecode
        echo FULLSYSTEM_VDF_PROFILE=timecode
        ;;
    *) echo FULLSYSTEM_VDF_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.hdmi-connect=control "*)
        export FULLSYSTEM_HDMI_CONNECTION=control
        echo FULLSYSTEM_HDMI_CONNECTION_PROFILE=control
        ;;
    *) echo FULLSYSTEM_HDMI_CONNECTION_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.adf-audio-connect=control "*)
        export FULLSYSTEM_ADF_AUDIO_CONNECTION=control
        echo FULLSYSTEM_ADF_AUDIO_CONNECTION_PROFILE=control
        ;;
    *) echo FULLSYSTEM_ADF_AUDIO_CONNECTION_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.dig-level=virtual "*)
        export FULLSYSTEM_DIG_LEVEL=virtual
        echo FULLSYSTEM_DIG_LEVEL_PROFILE=virtual
        ;;
    *) echo FULLSYSTEM_DIG_LEVEL_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.insmod=all "*)
        export FULLSYSTEM_INSMOD_POLICY=all
        echo all > /tmp/fullsystem-insmod-policy
        echo FULLSYSTEM_INSMOD_POLICY=all
        ;;
    *) echo FULLSYSTEM_INSMOD_POLICY=allow-list;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.dmm=unit-size "*)
        export FULLSYSTEM_DMM=unit-size
        echo FULLSYSTEM_DMM_PROFILE=unit-size
        ;;
    *) echo FULLSYSTEM_DMM_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.hdmi=boot "*)
        export FULLSYSTEM_HDMI_SERVICE=boot
        echo FULLSYSTEM_HDMI_PROFILE=boot
        ;;
    *" fullsystem.hdmi=definition "*)
        export FULLSYSTEM_HDMI_SERVICE=definition
        echo FULLSYSTEM_HDMI_PROFILE=definition
        ;;
    *) echo FULLSYSTEM_HDMI_PROFILE=off;;
esac
export QEMU_NO_CP_UPDATER=1 QEMU_CAPID_SERVICE=1 QEMU_SA_ADDRESS_SERVICE=1
case " $(cat /proc/cmdline) " in
    *" fullsystem.vef=registry "*)
        export FULLSYSTEM_VEF_SERVICE=registry
        echo FULLSYSTEM_VEF_PROFILE=registry
        ;;
    *) echo FULLSYSTEM_VEF_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.pinmem=registry "*)
        export FULLSYSTEM_PINMEM_SERVICE=registry
        echo FULLSYSTEM_PINMEM_PROFILE=registry
        ;;
    *) echo FULLSYSTEM_PINMEM_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.pin-connect=control "*)
        export FULLSYSTEM_PIN_CONNECTION=control
        echo FULLSYSTEM_PIN_CONNECT_PROFILE=control
        ;;
    *) echo FULLSYSTEM_PIN_CONNECT_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.pin-format=cold "*)
        case "$FULLSYSTEM_PIN_CONNECTION" in
            control) export FULLSYSTEM_PIN_FORMAT=cold;;
            *) echo FULLSYSTEM_PIN_FORMAT_REQUIRES_CONTROL; exit 1;;
        esac
        echo FULLSYSTEM_PIN_FORMAT_PROFILE=cold
        ;;
    *) echo FULLSYSTEM_PIN_FORMAT_PROFILE=off;;
esac
export QEMU_HDMI_FORMAT_SERVICE=1 QEMU_HDMI_PHOTO_SERVICE=1 QEMU_DMM_SERVICE=1
case " $(cat /proc/cmdline) " in
    *" fullsystem.scalar=registry "*)
        export FULLSYSTEM_SCALAR_SERVICE=registry
        echo FULLSYSTEM_SCALAR_PROFILE=registry
        ;;
    *) echo FULLSYSTEM_SCALAR_PROFILE=off;;
esac

case " $(cat /proc/cmdline) " in
    *" fullsystem.adf=registry "*)
        export FULLSYSTEM_ADF_SERVICE=registry
        echo FULLSYSTEM_ADF_PROFILE=registry
        ;;
    *) echo FULLSYSTEM_ADF_PROFILE=off;;
esac

case " $(cat /proc/cmdline) " in
    *" fullsystem.adf-connect=control "*)
        export FULLSYSTEM_ADF_CONNECTION=control
        echo FULLSYSTEM_ADF_CONNECT_PROFILE=control
        ;;
    *) echo FULLSYSTEM_ADF_CONNECT_PROFILE=off;;
esac

case " $(cat /proc/cmdline) " in
    *" fullsystem.hdmi-pin=registry "*)
        export FULLSYSTEM_HDMI_PIN_SERVICE=registry
        echo FULLSYSTEM_HDMIPIN_PROFILE=registry
        ;;
    *) echo FULLSYSTEM_HDMIPIN_PROFILE=off;;
esac
export QEMU_SOFTWARE_GPE=1 QEMU_GPE_RGBA4444=1 QEMU_DISPLAY_INFO_SERVICE=1
case " $(cat /proc/cmdline) " in
    *" fullsystem.scalar-connect=control "*)
        export FULLSYSTEM_SCALAR_CONNECTION=control
        echo FULLSYSTEM_SCALAR_CONNECT_PROFILE=control
        ;;
    *) echo FULLSYSTEM_SCALAR_CONNECT_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.infrabb-connect=control "*)
        export FULLSYSTEM_INFRABB_CONNECTION=control
        echo FULLSYSTEM_INFRABB_CONNECT_PROFILE=control
        ;;
    *) echo FULLSYSTEM_INFRABB_CONNECT_PROFILE=off;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.osd-headless=off "*)
        export MENU_HEADLESS_OSD=0
        echo FULLSYSTEM_OSD_HEADLESS=off
        ;;
    *) export MENU_HEADLESS_OSD=1; echo FULLSYSTEM_OSD_HEADLESS=on;;
esac
export QEMU_SOFTWARE_LZ77=1 MENU_OSD_OBSERVE=1
export MENU_FRAME_OBSERVE=1 MENU_CTOR_CENSUS=1 MENU_OPEN_SET=0x308
export MENU_OPEN_SET_LOG_ONLY=1 MENU_MODE_SENTINELS=1
# No MENU_APPLY_MENU, fake ready, or forced mode: observe the original boot path.
case " $(cat /proc/cmdline) " in
    *" fullsystem.bootin-handoff=p15-wrapper "*)
        echo "FULLSYSTEM_BOOTIN_ORIGINAL path=$original_elf pid=$$ argc=$#";;
esac
exec "$original_elf" "$@"
