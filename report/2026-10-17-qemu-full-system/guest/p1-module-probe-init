#!/bin/busybox sh
# Diagnostic RAM root only. No original updater or filesystem write is invoked.
export PATH=/bin
bb=/bin/busybox
fail() {
    echo "P1_FAIL stage=$1 rc=${2:-1}"
    while :; do $bb sleep 3600; done
}
[ "$$" = 1 ] || fail pid1
$bb mount -t proc proc /proc || fail proc "$?"
$bb mount -t sysfs sysfs /sys || fail sysfs "$?"
$bb mount -t devtmpfs devtmpfs /dev || fail devtmpfs "$?"
echo P1_PROBE_BEGIN
while read -r key a b c d rest; do
    case "$key" in
        Uid:|Gid:)
            echo "P1_CREDENTIAL kind=$key values=$a,$b,$c,$d"
            [ "$a,$b,$c,$d" = 0,0,0,0 ] || fail credentials;;
    esac
done < /proc/$$/status
echo "P1_RELEASE value=$($bb uname -r)"
$bb insmod /qemu/sony_persistent_flash.ko
rc=$?
echo "P1_INSMOD rc=$rc"
echo P1_MODULES_BEGIN
$bb cat /proc/modules
echo P1_MODULES_END
[ "$rc" = 0 ] || fail insmod "$rc"
while read -r node sectors; do
    actual=$($bb cat "/sys/block/$node/size") || fail capacity-read "$?"
    echo "P1_CAPACITY node=$node expected=$sectors actual=$actual"
    [ "$actual" = "$sectors" ] || fail capacity-mismatch
done < /qemu/capacities
while read -r node sector sha; do
    $bb dd "if=/dev/$node" of=/tmp/block bs=512 "skip=$sector" count=1 || fail block-read "$?"
    /qemu/audit copy /tmp/block /tmp/verified 512 "$sha" 600 || fail block-digest "$?"
    echo "P1_READ node=$node sector=$sector bytes=512 sha256=$sha"
    $bb rm /tmp/block /tmp/verified || fail sample-cleanup "$?"
done < /qemu/samples
while read -r id fs node path bytes sha; do
    $bb mount -t "$fs" -o ro "/dev/$node" "/mnt/$id"
    rc=$?
    echo "P1_MOUNT id=$id fs=$fs node=$node rc=$rc"
    [ "$rc" = 0 ] || fail "mount-$id" "$rc"
    echo "P1_MOUNTINFO_BEGIN id=$id"
    $bb cat /proc/self/mountinfo
    echo "P1_MOUNTINFO_END id=$id"
    /qemu/audit copy "/mnt/$id$path" /tmp/file-readback "$bytes" "$sha" 600 || fail "file-$id" "$?"
    echo "P1_FILE id=$id bytes=$bytes sha256=$sha"
    $bb rm /tmp/file-readback || fail file-cleanup "$?"
    $bb umount "/mnt/$id"
    rc=$?
    echo "P1_UNMOUNT id=$id rc=$rc"
    [ "$rc" = 0 ] || fail "unmount-$id" "$rc"
done < /qemu/files
echo P1_PROBE_COMPLETE
while :; do $bb sleep 3600; done
