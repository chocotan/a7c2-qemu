#!/bin/busybox sh
# Original init2 invokes its original list. Unsupported hardware is refused visibly.
#
# The allow-list below is a POLICY, not a physical limit: a module whose hardware
# contract is not modeled can hang the kernel on an unmodeled MMIO read, or write
# state that later looks like success. Refusing keeps the boot baseline honest.
# Set FULLSYSTEM_INSMOD_POLICY=all to load every requested module anyway; that is
# how the media stack gets tested, and the kernel log is the evidence either way.
name=${1##*/}
name=${name%.ko}
module=$1
shift
case "$name" in
    input)
        case " $(cat /proc/cmdline) " in
            *" fullsystem.gpio-c1=virtual "*)
                /simulation/gpio-pad-state release || { echo FULLSYSTEM_GPIO_PAD_FAILED; exit 1; };;
        esac
        /bin/busybox insmod "$module" "$@"
        result=$?
        case " $(cat /proc/cmdline) " in
            *" fullsystem.gpio-c1=virtual "*)
                /simulation/gpio-pad-state read || { echo FULLSYSTEM_GPIO_PAD_FAILED; exit 1; };;
        esac
        ;;
    devno|osal_utm|osal_uipc|utimer|osal_ulogio|ioexp|indctr|udate|stream|stream2|dmm|kikilog|upm|grm_ma)
        /bin/busybox insmod "$module" "$@"
        result=$?
        ;;
    backup)
        # The original loader has not filled Backup RAM; read the actual dump file.
        /bin/busybox insmod "$module" Backup_load=1 Backup_save=0
        result=$?
        if [ "$result" = 0 ]; then
            /simulation/seed-power-on 1 || { echo FULLSYSTEM_BOOT_RECORD_FAILED; exit 1; }
        fi
        ;;
    *)
        # The original loader may invoke us with a clean environment, so read the
        # policy from a marker file as well as the environment.
        policy=$FULLSYSTEM_INSMOD_POLICY
        [ -r /tmp/fullsystem-insmod-policy ] && policy=$(cat /tmp/fullsystem-insmod-policy)
        allowed=no
        case "$policy" in
            all) allowed=yes;;
            media)
                # The media stack only. pcieatu is excluded on evidence: it reads
                # an unmodeled ATU register and oopses the kernel at 6.8s.
                case "$name" in
                    mmc_core|mcmn_drv|mmcioWrapper|mmc_drv|emmc|crypt-emmc|ms_drv|sd_mod) allowed=yes;;
                esac
                ;;
            media-rm)
                # RM/media-request layer without the MMC host driver. mmc_drv
                # oopses in mmc_hw_ipsxwrp_init on an unmodeled wrapper register,
                # so it stays out while we test whether the RM endpoint alone
                # changes media detection.
                case "$name" in
                    mmc_core|mcmn_drv|mmcioWrapper) allowed=yes;;
                    usbg_sen)
                        case " $(cat /proc/cmdline) " in
                            *" fullsystem.usb-service=original-sen-observe-v1 "*) allowed=yes;;
                        esac;;
                    usb_portMonitor)
                        case " $(cat /proc/cmdline) " in
                            *" fullsystem.usb-monitor=original "*) allowed=yes;;
                        esac;;
                esac
                ;;
        esac
        if [ "$allowed" = yes ]; then
            if [ "$name" = usb_portMonitor ]; then
                echo "FULLSYSTEM_MODULE_REQUEST module=$module name=$name argc=$#"
                for argument in "$@"; do echo "FULLSYSTEM_MODULE_ARGUMENT=$argument"; done
                [ "$module" = /usr/kmod/usb_portMonitor.ko ] || exit 78
                digest=$(/usr/bin/openssl dgst -sha256 "$module") || exit 1
                echo "$digest"
                case "$digest" in
                    "SHA256(/usr/kmod/usb_portMonitor.ko)= 792cbc38576efba8e33faf730514f9ac694883b2668019ced0581abeb4b6f73d"|"SHA2-256(/usr/kmod/usb_portMonitor.ko)= 792cbc38576efba8e33faf730514f9ac694883b2668019ced0581abeb4b6f73d") ;;
                    *) echo FULLSYSTEM_USB_MONITOR_IDENTITY_FAILED; exit 1;;
                esac
            fi
            if [ "$name" = usbg_sen ]; then
                echo "FULLSYSTEM_MODULE_REQUEST module=$module name=$name argc=$#"
                for argument in "$@"; do echo "FULLSYSTEM_MODULE_ARGUMENT=$argument"; done
                [ "$module" = /usr/kmod/usbg_sen.ko ] || exit 78
                digest=$(/usr/bin/openssl dgst -sha256 "$module") || exit 1
                echo "$digest"
                case "$digest" in
                    "SHA256(/usr/kmod/usbg_sen.ko)= cd85574e2cfa8dce40d61fde0f46c892df1c39203677cea51770d1963d6fa148"|"SHA2-256(/usr/kmod/usbg_sen.ko)= cd85574e2cfa8dce40d61fde0f46c892df1c39203677cea51770d1963d6fa148") ;;
                    *) echo FULLSYSTEM_USB_SEN_IDENTITY_FAILED; exit 1;;
                esac
            fi
            echo "FULLSYSTEM_MODULE_POLICY_LOAD $name"
            /bin/busybox insmod "$module" "$@"
            result=$?
        else
            if [ "$name" = usbg_storage ]; then
                case " $(cat /proc/cmdline) " in
                    *" fullsystem.usb-service=original-sen-observe-v1 "*)
                        echo "FULLSYSTEM_MODULE_REQUEST module=$module name=$name argc=$#"
                        for argument in "$@"; do echo "FULLSYSTEM_MODULE_ARGUMENT=$argument"; done
                        echo 'FULLSYSTEM_USB_STORAGE_DENIED expected_path=/usr/kmod/usbg_storage.ko expected_bytes=104288 expected_sha256=65755c15be728daa2f6889d72a0aa0db9efadfb48361390222ba7a0e568529fa builtin=unknown registration_proven=0'
                        if [ "$module" = /usr/kmod/usbg_storage.ko ] && [ -r "$module" ]; then
                            /usr/bin/openssl dgst -sha256 "$module"
                            echo "FULLSYSTEM_USB_STORAGE_DIGEST_RC=$?"
                        fi
                        /bin/busybox grep '^usbg_storage ' /proc/modules
                        echo "FULLSYSTEM_USB_STORAGE_LIVE_READ_RC=$?"
                        ;;
                esac
            fi
            echo "FULLSYSTEM_MODULE_UNSUPPORTED $name hardware-contract-not-modeled"
            exit 78
        fi
        ;;
esac
echo "FULLSYSTEM_MODULE_RESULT $name result=$result"
exit "$result"
