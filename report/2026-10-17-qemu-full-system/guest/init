#!/bin/busybox sh
# Original partition bytes are private in-memory copies. No physical devices.
export HOME=/ PATH=/sbin:/bin:/usr/sbin:/usr/bin
export TOPRC=/etc/toprc MALLOC_OPTIONS=gfffffffff MALLOC_MMAP_THRESHOLD_=131072
export MALLOC_CHECK_=3 LT_ABORTREASON=0 WBSHD=/tmp_wbshd/shared.XXXXXX
busybox mount -t devtmpfs devtmpfs /dev
busybox mount -t proc proc /proc
busybox mount -t sysfs none /sys
busybox mount -t debugfs none /sys/kernel/debug
mkdir -p /dev/pts
busybox mount -t devpts none /dev/pts

index=0
for pair in 1:nflasha1.img 2:nflasha2.img 3:nflasha3.img 4:nflasha4.img 5:nflasha5.img 6:nflasha6.img 8:nflasha8.img 10:nflasha10.img 11:nflasha11.img 12:nflasha12.img 13:nflasha13.img 15:a7c2-usr.img 18:nflasha18.img 22:nflasha22.img 23:nflasha23.img 30:nflasha30.img B0:nflashaB0.img B1:nflashaB1.img; do
    part=${pair%%:*}
    image=${pair#*:}
    loop=/dev/loop$index
    [ -b "$loop" ] || busybox mknod "$loop" b 7 "$index"
    access=rw
    [ "$part" = 15 ] && access=ro
    /simulation/attach-loop "$index" "/partitions/$image" "$access" || { echo FULLSYSTEM_LOOP_FAILED; exec /bin/busybox sh; }
    ln -s "$loop" "/dev/nflasha$part"
    index=$((index + 1))
done
busybox mount -a -T /sbin/initrc/fstab || { echo FULLSYSTEM_FSTAB_FAILED; exec /bin/busybox sh; }
busybox mount -a -T /sbin/initrc/fstab.ext || { echo FULLSYSTEM_FSTAB_EXT_FAILED; exec /bin/busybox sh; }
mkdir -p /log/qemu
# Keep experiment logs off the shared 12 MiB tmp/etc/var volume.
for file in menu-load.log gpe-requests.bin im.log; do
    rm -f "/tmp/$file"
    ln -s "/log/qemu/$file" "/tmp/$file"
done
# Do not source a potentially device-specific profile/recovery hook.
echo FULLSYSTEM_MOUNTS_READY
busybox mount
echo FULLSYSTEM_INTERRUPTS_BEFORE_SHELL
cat /proc/interrupts
/simulation/board-regs
case " $(cat /proc/cmdline) " in
    *" fullsystem.gic_handoff=1 "*)
        /simulation/init-gic || { echo FULLSYSTEM_GIC_HANDOFF_FAILED; exec /bin/busybox sh; }
        ;;
esac
case " $(cat /proc/cmdline) " in
    *" fullsystem.uart_pin=1 "*)
        echo 1 > /proc/irq/33/smp_affinity
        echo "FULLSYSTEM_UART_PIN_RC=$?"
        ;;
esac
/simulation/board-regs 8 &
exec /bin/busybox sh </dev/ttyAMA0 >/dev/ttyAMA0 2>&1
