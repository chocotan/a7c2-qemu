#!/bin/sh
# Isolated QEMU adapter; original p1 scripts keep their bytes and branches.
bb=/bin/busybox
unset A7C2_P1_PMBP_PROFILE
persistent_load()
{
    if [ ! -e /simulation/storage-profile ]; then
        [ ! -L /simulation/storage-profile ] || return 125
        $bb insmod /simulation/sony_persistent_flash.ko
        return "$?"
    fi
    [ -f /simulation/storage-profile ] && [ ! -L /simulation/storage-profile ] || return 125
    [ "$($bb cat /simulation/storage-profile)" = 'virtual-p1-alfred-trim-zero-v1 8aaea09a134293c7f5b498346abca60937c9fdffa27ff6fc579c65618a19f293 functional_alfred_trim_zero=1' ] || return 125
    [ ! -e /simulation/read-only-probe ] && [ ! -e /simulation/sd-no-install ] && [ ! -e /simulation/block-readonly-verified ] || return 125
    [ -f /simulation/install-authorization ] && [ -f /simulation/backup-trusted-file-load ] || return 125
    /simulation/audit copy /simulation/sony_persistent_flash.ko /simulation/trim-module-readback 65112 8aaea09a134293c7f5b498346abca60937c9fdffa27ff6fc579c65618a19f293 600
    rc=$?
    $bb rm -f /simulation/trim-module-readback
    [ "$rc" -eq 0 ] || return 125
    if [ -e /simulation/pmbp-runtime/profile ]; then
        /simulation/pmbp-runtime/bootstrap /simulation/pmbp-runtime manifest.bin module-load
    else
        $bb insmod /simulation/sony_persistent_flash.ko functional_alfred_trim_zero=1
    fi
    rc=$?
    [ "$rc" -eq 0 ] || return "$rc"
    value=$($bb cat /sys/module/sony_persistent_flash/parameters/functional_alfred_trim_zero) || return 125
    echo "UPDATE_STORAGE_PARAMETER profile=virtual-p1-alfred-trim-zero-v1 name=functional_alfred_trim_zero value=$value"
    [ "$value" = Y ] || return 125
}
install_guard()
{
    [ "$($bb cat /simulation/sd-read-profile)" = original-p1-virtual-install-v1 ] || return 125
    [ "$($bb cat /simulation/update-profile)" = official ] || return 125
    [ ! -e /simulation/read-only-probe ] && [ ! -e /simulation/sd-no-install ] || return 125
    [ "$($bb cat /simulation/backup-trusted-file-load)" = original-p1-virtual-install-v1 ] || return 125
    read -r auth receipt clone rest < /simulation/install-authorization
    [ "$auth" = original-p1-virtual-install-v1 ] && [ -z "$rest" ] || return 125
    case "$receipt$clone" in *[!0-9a-f]*) return 125 ;; esac
    [ "${#receipt}:${#clone}" = 64:64 ] || return 125
    [ "$($bb cat /simulation/install-authorization)" = "$auth $receipt $clone" ] || return 125
    [ "$A7C2_FILE_MEDIA_TEST:$A7C2_P1_FILE_MEDIA_PROFILE" = 1:original-sd-v1 ] || return 125
    /simulation/install-target /dev/pnflasha /dev/cnflasha[0-9]* /dev/nflashaB0 /dev/nflashaB1 || return 125
    echo "UPDATE_INSTALL_GUARD profile=$auth receipt=$receipt clone=$clone target_rw=20"
}
sd_read_guard()
{
    if [ "$($bb cat /simulation/sd-read-profile)" = original-p1-virtual-install-v1 ]; then
        install_guard || return 125
        [ -f /image_mmca ] && [ ! -L /image_mmca ] || return 125
        # The initial boot check precedes loading resources; the receiver checks all twelve.
        if [ "${0##*/}" = sdfileinput.elf ]; then
            for required in devno osal_utm osal_uipc utimer backup osal_ulogio dmm stream2 mcmn_drv mmc_drv nvme_core nvme; do
                $bb grep -E "^$required [0-9]+ [0-9]+ .* Live " /proc/modules || return 125
            done
            [ -f /simulation/install-media-guard-verified ] || return 125
        fi
    else
        [ "$($bb cat /simulation/sd-read-profile)" = original-p1-sd-readonly-v1 ] || return 125
        [ "$($bb cat /simulation/sd-no-install)" = target-block-readonly-20 ] || return 125
    [ "$($bb cat /simulation/sd-read-env)" = 'A7C2_FILE_MEDIA_TEST=1
A7C2_P1_FILE_MEDIA_PROFILE=original-sd-v1' ] || return 125
    [ "$A7C2_FILE_MEDIA_TEST:$A7C2_P1_FILE_MEDIA_PROFILE" = 1:original-sd-v1 ] || return 125
    [ -f /simulation/read-only-probe ] && [ -f /simulation/block-readonly-verified ] || return 125
    [ -f /image_mmca ] && [ ! -L /image_mmca ] && [ -w /image_mmca ] || return 125
    /simulation/sd-target-ro /dev/pnflasha /dev/cnflasha[0-9]* /dev/nflashaB0 /dev/nflashaB1 || return 125
    fi
    [ -s /simulation/sd-read-bindings ] && [ ! -L /simulation/sd-read-bindings ] || return 125
    [ -f /simulation/sd-read-binding-count ] && [ ! -L /simulation/sd-read-binding-count ] || return 125
    IFS= read -r binding_expected < /simulation/sd-read-binding-count || return 125
    case "$binding_expected" in ''|0*|*[!0-9]*) return 125 ;; esac
    [ "${#binding_expected}" -le 4 ] && [ "$binding_expected" -le 4096 ] || return 125
    [ "$($bb wc -c < /simulation/sd-read-binding-count)" -eq "$((${#binding_expected} + 1))" ] || return 125
    binding_count=0
    while read -r path bytes hash rest; do
        [ -n "$path" ] && [ -n "$bytes" ] && [ -n "$hash" ] && [ -z "$rest" ] || return 125
        /simulation/audit copy "$path" /simulation/sd-binding-readback "$bytes" "$hash" 600
        rc=$?
        $bb rm -f /simulation/sd-binding-readback
        echo "UPDATE_SD_BINDING path=$path bytes=$bytes sha256=$hash rc=$rc"
        [ "$rc" -eq 0 ] || return 125
        binding_count=$((binding_count + 1))
        [ "$binding_count" -le 4096 ] || return 125
    done < /simulation/sd-read-bindings
    [ -z "$path$bytes$hash$rest" ] && [ "$binding_count" -eq "$binding_expected" ] || return 125
    unset A7C2_P1_PMBP_PROFILE
    if [ -e /simulation/pmbp-runtime/profile ]; then
        [ -f /simulation/pmbp-runtime/profile ] && [ ! -L /simulation/pmbp-runtime/profile ] || return 125
        [ "$($bb cat /simulation/pmbp-runtime/profile)" = virtual-p1-pmbp-block-slice-v1 ] || return 125
        export A7C2_P1_PMBP_PROFILE=virtual-p1-pmbp-block-slice-v1
    fi
    if [ "$($bb cat /simulation/sd-read-profile)" = original-p1-sd-readonly-v1 ]; then
        echo 'UPDATE_SD_EXEC_GUARD profile=original-p1-sd-readonly-v1 source_kind=functional-adapter no_install=1 target_ro=20'
    fi
}
receiver_snapshot()
{
    pid=$1
    echo "UPDATE_SD_RECEIVER_PROC_BEGIN pid=$pid"
    for name in status cmdline maps wchan stack environ; do
        echo "UPDATE_SD_RECEIVER_FILE pid=$pid name=$name"
        $bb cat "/proc/$pid/$name"
        echo
    done
    echo "UPDATE_SD_RECEIVER_PROC_END pid=$pid"
}
media_snapshot()
{
    [ -f /simulation/media-profile ] || return
    echo UPDATE_MEDIA_KERNEL_BEGIN
    $bb cat /proc/modules /proc/devices
    $bb ls -l /dev/mcmn /dev/stream2 /dev/mmc* /dev/nvme*
    for p in /proc/[0-9]*; do
        [ -r "$p/comm" ] || continue
        read -r comm < "$p/comm"
        case "$comm" in
            *RM*|*rm*|*UIPC*|*uipc*|*mmc*|*insmod*)
                echo "UPDATE_MEDIA_THREAD pid=${p##*/} comm=$comm"
                $bb cat "$p/status" "$p/wchan" "$p/stack" ;;
        esac
    done
    echo UPDATE_MEDIA_PROC_BEGIN
    $bb ls /proc /proc/driver
    if [ -r /proc/osal/uipc ]; then
        echo UPDATE_MEDIA_UIPC_BEGIN
        $bb cat /proc/osal/uipc
        echo UPDATE_MEDIA_UIPC_END
    fi
    echo UPDATE_MEDIA_PROC_END
    echo UPDATE_MEDIA_KERNEL_END
}
media_guard()
{
    [ "$($bb cat /simulation/media-profile)" = original-p1-media-readonly-v1 ] || return 125
    case "$($bb cat /simulation/sd-read-profile 2>/dev/null)" in
        original-p1-virtual-install-v1) install_guard || return 125 ;;
        original-p1-sd-readonly-v1|'')
            [ -f /simulation/read-only-probe ] && [ -f /simulation/block-readonly-verified ] || return 125 ;;
        *) return 125 ;;
    esac
    for required in devno osal_utm osal_uipc utimer backup osal_ulogio dmm stream2; do
        $bb grep -E "^$required [0-9]+ [0-9]+ .* Live " /proc/modules || return 125
    done
    for spec in Backup_load:1 Backup_save:0; do
        parameter=${spec%:*}
        value=$($bb cat "/sys/module/backup/parameters/$parameter")
        echo "UPDATE_MEDIA_PARAMETER name=$parameter value=$value"
        [ "$value" = "${spec#*:}" ] || return 125
    done
    $bb mount -t vfat -o ro /dev/nflasha2 /project-setting || return 125
    read -r backup_path backup_bytes backup_hash rest < /simulation/backup-file-source
    [ "$backup_path" = /setting/Backup.bin ] && [ -z "$rest" ] || return 125
    /simulation/audit copy /project-setting/Backup.bin /simulation/media-backup-readback "$backup_bytes" "$backup_hash" 600
    rc=$?
    $bb rm -f /simulation/media-backup-readback
    $bb umount /project-setting || return 125
    echo "UPDATE_MEDIA_BACKUP_FILE bytes=$backup_bytes sha256=$backup_hash rc=$rc"
    [ "$rc" -eq 0 ] || return 125
    /simulation/media-backup-query
    rc=$?
    echo "UPDATE_MEDIA_GUARD rc=$rc"
    if [ "$rc" -eq 0 ] && [ "$($bb cat /simulation/sd-read-profile 2>/dev/null)" = original-p1-virtual-install-v1 ]; then
        $bb touch /simulation/install-media-guard-verified || return 125
    fi
    return "$rc"
}
case "$0" in
    */sdfileinput.elf)
        sd_read_guard || exit 125
        if [ -e /simulation/pmbp-runtime/profile ]; then
            /simulation/pmbp-runtime/bootstrap /simulation/pmbp-runtime manifest.bin receiver /usr/bin/sdfileinput.elf "$@" &
        else
            /usr/bin/sdfileinput.elf "$@" &
        fi
        receiver_pid=$!
        echo "UPDATE_SD_RECEIVER_START pid=$receiver_pid original=/usr/bin/sdfileinput.elf"
        receiver_snapshot "$receiver_pid"
        wait "$receiver_pid"
        receiver_rc=$?
        echo "UPDATE_SD_RECEIVER_EXIT pid=$receiver_pid rc=$receiver_rc"
        exit "$receiver_rc" ;;
    */insmod|*/rmmod)
        case "$0" in
            */insmod)
                # Exact paths precede the manifest lookup; options and aliases cannot widen it.
                case "$1" in
                    /kmod/devno.ko|/usr/kmod/osal_utm.ko|/usr/kmod/osal_uipc.ko|/usr/kmod/utimer.ko|/usr/kmod/backup.ko|/usr/kmod/osal_ulogio.ko|/usr/kmod/dmm.ko|/usr/kmod/stream2.ko|/usr/kmod/mcmn_drv.ko|/usr/kmod/mmc_drv.ko|/usr/kmod/nvme-core.ko|/usr/kmod/nvme.ko)
                        case "$1" in
                            */stream2.ko|*/mcmn_drv.ko|*/mmc_drv.ko|*/nvme-core.ko|*/nvme.ko)
                                [ -f /simulation/media-profile ] && [ "$#" -eq 1 ] || exit 125 ;;
                        esac
                        if [ -r /simulation/original-modules ]; then
                            while read -r path bytes hash rest; do
                                [ "$path" = "$1" ] || continue
                                [ -z "$rest" ] || exit 125
                                for arg in "$@"; do
                                    case "$arg" in -*)
                                        echo "UPDATE_MODULE_REJECT applet=$0 module=$1 adapter_rc=125 original_module_rc=notexecuted reason=module-option-refused" >&2
                                        exit 125 ;;
                                    esac
                                done
                                if [ "$1" = /usr/kmod/backup.ko ]; then
                                    case "$#:$2:$3" in
                                        2:Backup_save=0:|3:Backup_load=1:Backup_save=0) ;;
                                        *) echo "UPDATE_MODULE_REJECT applet=$0 module=$1 adapter_rc=125 original_module_rc=notexecuted reason=backup-write-policy" >&2; exit 125 ;;
                                    esac
                                fi
                                /simulation/audit copy "$1" "/simulation/module-readback-$$" "$bytes" "$hash" 600
                                rc=$?
                                $bb rm -f "/simulation/module-readback-$$"
                                if [ "$rc" -ne 0 ]; then
                                    echo "UPDATE_MODULE_REJECT applet=$0 module=$1 adapter_rc=125 original_module_rc=notexecuted reason=source-digest-differs" >&2
                                    exit 125
                                fi
                                echo "UPDATE_MODULE_BEGIN module=$1 bytes=$bytes sha256=$hash argc=$#"
                                for arg in "$@"; do echo "UPDATE_MODULE_ARG value=$arg"; done
                                if [ "$1" = /usr/kmod/backup.ko ] && [ -f /simulation/backup-file-source ]; then
                                    if [ -f /simulation/backup-trusted-file-load ]; then
                                        install_guard || exit 125
                                    else
                                        [ -f /simulation/read-only-probe ] || exit 125
                                    fi
                                    read -r backup_path backup_bytes backup_hash rest < /simulation/backup-file-source
                                    [ "$backup_path" = /setting/Backup.bin ] && [ -z "$rest" ] || exit 125
                                    /simulation/audit copy "$backup_path" "/simulation/backup-readback-$$" "$backup_bytes" "$backup_hash" 600
                                    rc=$?
                                    $bb rm -f "/simulation/backup-readback-$$"
                                    echo "UPDATE_BACKUP_FILE bytes=$backup_bytes sha256=$backup_hash rc=$rc"
                                    [ "$rc" -eq 0 ] || exit 125
                                    if [ "$#" -eq 2 ]; then set -- "$@" Backup_load=1; fi
                                    if [ -f /simulation/backup-trusted-file-load ]; then
                                        [ "$backup_bytes:$backup_hash" = 2390264:b863f8b61d1a979b964419a99c9a0f27169958f8f5cbb204b7a4eee3b127cdff ] || exit 125
                                        echo 'UPDATE_BACKUP_LOAD_ADAPTER appended=Backup_load=1 save=0 storage=exclusive-virtual-clone trusted_file_load=1 original_argv=preserved'
                                    else
                                        echo 'UPDATE_BACKUP_LOAD_ADAPTER appended=Backup_load=1 save=0 storage=block-readonly original_argv=preserved'
                                    fi
                                fi
                                if [ "$1" = /usr/kmod/mcmn_drv.ko ]; then
                                    media_guard
                                    rc=$?
                                    if [ "$rc" -ne 0 ]; then
                                        echo "UPDATE_MODULE_REJECT applet=$0 module=$1 adapter_rc=125 original_module_rc=notexecuted reason=original-backup-guard" >&2
                                        exit 125
                                    fi
                                fi
                                $bb insmod "$@"
                                rc=$?
                                echo "UPDATE_MODULE_RESULT module=$1 original_module_rc=$rc"
                                case "$1" in */mcmn_drv.ko|*/mmc_drv.ko|*/nvme-core.ko|*/nvme.ko) media_snapshot ;; esac
                                exit "$rc"
                            done < /simulation/original-modules
                        fi ;;
                esac ;;
        esac
        echo "UPDATE_MODULE_REJECT applet=$0 module=$1 adapter_rc=125 original_module_rc=notexecuted reason=unmodeled-resource" >&2
        exit 125 ;;
    */mkramdsk.sh|*/insmod.sh|*/UdtrMain.sh|*/execute_prod.sh|*/execute_ufp.sh)
        name=${0##*/}
        echo "UPDATE_ORIGINAL_SCRIPT path=/usr/bin/$name pid=$$ interpreter=/bin/sh trace=external-x"
        if [ "$name" = insmod.sh ] && [ -r /simulation/original-modules ]; then
            /bin/sh -x "/usr/bin/$name" "$@"
            rc=$?
            echo "UPDATE_ORIGINAL_MODULE_SCRIPT_RC=$rc"
            echo UPDATE_RESOURCE_MODULES_BEGIN
            $bb cat /proc/modules
            echo UPDATE_RESOURCE_MODULES_END
            echo UPDATE_RESOURCE_DEVICES_BEGIN
            $bb cat /proc/devices
            echo UPDATE_RESOURCE_DEVICES_END
            echo UPDATE_RESOURCE_MOUNTS_BEGIN
            $bb cat /proc/mounts
            echo UPDATE_RESOURCE_MOUNTS_END
            $bb ls -l /dev/uipc /dev/backup
            if [ -x /simulation/uipc-native-status ]; then /simulation/uipc-native-status; fi
            for parameter in /sys/module/backup/parameters/* /sys/module/dmm/parameters/*; do
                [ -r "$parameter" ] || continue
                echo "UPDATE_RESOURCE_PARAMETER path=$parameter"
                $bb cat "$parameter"
                echo
            done
            exit "$rc"
        fi
        exec /bin/sh -x "/usr/bin/$name" "$@" ;;
esac

export HOME=/
export PATH=/sbin:/bin:/usr/bin
export LD_LIBRARY_PATH=/lib:/usr/lib
blocked()
{
    echo "UPDATE_BOOT_BLOCKED stage=$1 rc=$2 reason=$3"
    while :; do $bb sleep 60; done
}
$bb mount -t proc proc /proc || blocked proc "$?" mount-failed
$bb mount -t sysfs sysfs /sys || blocked sysfs "$?" mount-failed
$bb mount -t devtmpfs devtmpfs /dev || blocked devtmpfs "$?" mount-failed
exec </dev/console >/dev/console 2>&1
while read -r key a b c d rest; do
    case "$key" in
        Uid:|Gid:)
            echo "UPDATE_CREDENTIAL kind=$key values=$a,$b,$c,$d"
            [ "$a,$b,$c,$d" = 0,0,0,0 ] || blocked credentials 77 non-root ;;
    esac
done < /proc/$$/status
echo "UPDATE_RELEASE value=$($bb uname -r)"
echo 'UPDATE_BOOT_STORAGE_ADAPTER=project-persistent-flash-v1 PHYSICAL_CRYPT_EMMC=notexecuted'
persistent_load
rc=$?
echo "UPDATE_PERSISTENT_INSMOD_RC=$rc"
echo UPDATE_MODULES_BEGIN
$bb cat /proc/modules
echo UPDATE_MODULES_END
[ "$rc" -eq 0 ] || blocked persistent-module "$rc" original-kernel-module-abi-or-device-failed
/bin/sh /simulation/create-aliases
rc=$?
echo "UPDATE_PERSISTENT_ALIASES_RC=$rc"
[ "$rc" -eq 0 ] || blocked persistent-aliases "$rc" incomplete-device-nodes
if [ -e /simulation/storage-profile ]; then
    [ -L /dev/nflasha4 ] && [ "$($bb readlink /dev/nflasha4)" = cnflasha4 ] && [ -b /dev/cnflasha4 ] || blocked storage-alias 125 nflasha4-mapping-differs
    echo 'UPDATE_STORAGE_ALIAS nflasha4=cnflasha4 verified=1'
fi
if [ -f /simulation/read-only-probe ]; then
    /simulation/block-readonly /dev/pnflasha /dev/cnflasha[0-9]* /dev/nflashaB0 /dev/nflashaB1
    rc=$?
    [ "$rc" -eq 0 ] || blocked read-only "$rc" block-device-protection-failed
    $bb touch /simulation/block-readonly-verified
fi
if [ -f /simulation/original-audit ]; then
    while read -r path bytes hash; do
        /simulation/audit copy "$path" /simulation/original-readback "$bytes" "$hash" 600
        rc=$?
        echo "UPDATE_ORIGINAL_BYTES path=$path bytes=$bytes sha256=$hash rc=$rc"
        [ "$rc" -eq 0 ] || blocked original-bytes "$rc" source-digest-differs
        $bb rm /simulation/original-readback
    done < /simulation/original-audit
fi
$bb mkdir -p /project-setting
$bb mount -t vfat -o ro /dev/nflasha2 /project-setting
rc=$?
echo "UPDATE_P2_RO_MOUNT_RC=$rc"
[ "$rc" -eq 0 ] || blocked p2 "$rc" original-fat-mount-failed
base=0
mode5=0
comp=0
uincomp=0
selected=1
[ -f /project-setting/updater/mode ] && base=1
[ -f /project-setting/updater/mode5 ] && mode5=1
[ -f /project-setting/updater/comp ] && comp=1
[ -f /project-setting/updater/uincomp ] && uincomp=1
if [ "$base" -eq 1 ]; then
    selected=0
    for mode in 3 2 6 1 5 7; do
        if [ -f "/project-setting/updater/mode$mode" ]; then selected=$mode; break; fi
    done
fi
[ -f /root/IAMLDUDWRT ] && selected=1
echo "UPDATE_P2_ACTUAL base=$base mode5=$mode5 comp=$comp uincomp=$uincomp selected=$selected frontend=notexecuted"
$bb umount /project-setting
rc=$?
[ "$rc" -eq 0 ] || blocked p2-unmount "$rc" original-fat-unmount-failed
if [ -f /simulation/sd-input-configured ]; then
    [ "$selected" -eq 5 ] || blocked p2-mode 70 actual-mode-does-not-select-sdfileinput
    [ "$uincomp" -eq 0 ] || blocked p2-uincomp 54 original-incomplete-update-flag
    [ -f /image_mmca ] || blocked sd-input 71 ordinary-fat-image-missing
    export A7C2_FILE_MEDIA_TEST=1
    if [ -f /simulation/sd-read-profile ]; then
        export A7C2_P1_FILE_MEDIA_PROFILE=original-sd-v1
        sd_read_guard || blocked sd-profile 125 no-install-or-input-binding-failed
    fi
    echo 'UPDATE_SD_BACKEND=original-file-media INPUT=/image_mmca CONSUMED=unverified'
fi
profile=$($bb cat /simulation/update-profile)
case "$profile" in
    official) echo 'UPDATE_SIGNATURE_POLICY=stock BYPASS_CONFIGURED=0 BYPASS_EXECUTED=unverified' ;;
    virtual-dev-sd-update-v1) echo 'UPDATE_SIGNATURE_POLICY=exact-derived-rsa-call BYPASS_CONFIGURED=1 BYPASS_EXECUTED=unverified' ;;
    *) blocked profile 72 unknown-profile ;;
esac
# Independent /proc observer; it does not answer hardware or alter script results.
if [ -f /simulation/execution-observer ]; then
    (
        while :; do
            echo UPDATE_PROCESS_SNAPSHOT_BEGIN
            for p in /proc/[0-9]*; do
                [ -r "$p/comm" ] || continue
                read -r comm < "$p/comm"
                case "$comm" in
                    sh|init|*elf|mf|sauu)
                        echo "UPDATE_PROCESS pid=${p##*/} comm=$comm"
                        $bb cat "$p/cmdline"
                        echo
                        echo "UPDATE_MAPS_BEGIN pid=${p##*/}"
                        $bb cat "$p/maps"
                        if [ "$comm" = sdfileinput.elf ] && [ -f /simulation/sd-read-profile ]; then
                            receiver_snapshot "${p##*/}"
                        fi ;;
                esac
            done
            echo UPDATE_PROCESS_SNAPSHOT_END
            if [ -f /simulation/original-modules ] && [ ! -f /simulation/resource-late-observed ]; then
                if [ -d /sys/module/dmm ] || [ -d /sys/module/backup ]; then
                    echo UPDATE_RESOURCE_SYSFS_BEGIN
                    $bb ls -l /sys/module/osal_uipc /sys/module/backup /sys/module/dmm
                    echo UPDATE_RESOURCE_SYSFS_END
                    $bb touch /simulation/resource-late-observed
                fi
            fi
            if [ -f /simulation/media-profile ]; then media_snapshot; fi
            $bb sleep 1
        done
    ) &
fi
export PS4='+UPDATE_TRACE pid=$$ '
echo 'UPDATE_ORIGINAL_INIT_EXEC=/sbin/init UDTRMAIN=unverified SDFILEINPUT=unverified BODYWRITER=unverified'
exec /bin/sh -x /sbin/init
