#!/bin/busybox sh
# Only prepare virtual storage; the original init owns all root and app handoffs.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
fail()
{
    echo "COLD_BOOTSTRAP_FAILED stage=$1 rc=${2:-1}"
    exec /bin/busybox sh </dev/console >/dev/console 2>&1
}
[ "$$" = 1 ] || fail not-pid1
proc_owned=0
if [ ! -r /proc/self/mountinfo ]; then
    /bin/busybox mount -t proc proc /proc || fail proc
    proc_owned=1
fi
profile_count=0
for parameter in $(/bin/busybox cat /proc/cmdline); do
    case "$parameter" in
        coldchain.profile=ram0-loop-v1) profile_count=$((profile_count + 1));;
        coldchain.profile=*|fullsystem.attach-sd=*|fullsystem.bootin-sd=*) fail wrong-profile;;
    esac
done
[ "$profile_count" = 1 ] || fail missing-profile
[ ! -e /dev/mmca2 ] && [ ! -L /dev/mmca2 ] || fail sd-conflict
[ ! -e /dev/qemu-partitions ] && [ ! -L /dev/qemu-partitions ] || fail partitions-exist
[ ! -e /dev/qemu-simulation ] && [ ! -L /dev/qemu-simulation ] || fail simulation-exists

dev_mount=0
while IFS= read -r line; do
    case "$line" in
        *" /dev "*" - devtmpfs "*) dev_mount=$((dev_mount + 1));;
    esac
done < /proc/self/mountinfo
[ "$dev_mount" = 1 ] || fail dev-not-devtmpfs
. /qemu/cold.conf || fail config
managed_kib=0
available_kib=0
while read -r key value unit; do
    case "$key" in
        MemTotal:) managed_kib=$value;;
        MemAvailable:) available_kib=$value;;
    esac
done < /proc/meminfo
echo "COLD_MEMORY managed_kib=$managed_kib available_kib=$available_kib required_managed_kib=$COLD_MANAGED_KIB required_available_kib=$COLD_AVAILABLE_KIB"
[ "$managed_kib" -ge "$COLD_MANAGED_KIB" ] || fail managed-memory
[ "$available_kib" -ge "$COLD_AVAILABLE_KIB" ] || fail available-memory
/bin/busybox mount -o "remount,size=$COLD_DEV_BYTES" devtmpfs /dev || fail dev-capacity
/qemu/cold-start-audit space /dev "$COLD_COPY_BYTES" || fail dev-space
/bin/busybox mkdir -m 700 /dev/qemu-partitions /dev/qemu-simulation || fail backing-directories

while read -r relative bytes sha mode; do
    parent=${relative%/*}
    if [ "$parent" != "$relative" ]; then
        /bin/busybox mkdir -p "/dev/qemu-simulation/$parent" || fail simulation-directory
    fi
    /qemu/cold-start-audit copy "/qemu-input/simulation/$relative" "/dev/qemu-simulation/$relative" "$bytes" "$sha" "$mode" || fail simulation-copy
done < /qemu/simulation-list

while read -r index part name bytes sha access; do
    /qemu/cold-start-audit copy "/qemu-input/partitions/$name" "/dev/qemu-partitions/$name" "$bytes" "$sha" 600 || fail partition-copy
    loop=/dev/loop$index
    [ -b "$loop" ] || /bin/busybox mknod "$loop" b 7 "$index" || fail loop-node
    /dev/qemu-simulation/attach-loop "$index" "/partitions/$name" "$access" || fail loop-attach
    case "$part" in
        B0|B1) /bin/busybox ln -s "$loop" "/dev/nflasha$part" || fail loader-alias;;
        *) /bin/busybox ln -s "$loop" "/dev/pnflasha$part" || fail partition-alias;;
    esac
done < /qemu/volume-list

echo COLD_BEFORE_ORIGINAL_INIT
/bin/busybox cat /proc/cmdline /proc/1/status /proc/1/mountinfo
/bin/busybox ls -l /dev/pnflasha7 /dev/qemu-partitions /dev/qemu-simulation
# End every helper before the original init later frees this RAM filesystem.
if [ "$proc_owned" = 1 ]; then
    /bin/busybox umount /proc || fail proc-release
fi
cd / || fail cwd
exec /bin/busybox sh -x /sbin/init
