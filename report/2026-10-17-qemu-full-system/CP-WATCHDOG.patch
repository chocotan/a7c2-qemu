+/*
+ * Limited CXD90057 watchdog/reset model for the isolated CP experiment.
+ * Register contract: Sony include/linux/wdt.h and mach/{platform,regs-scu}.h.
+ * Only the reset mode exercised by CP 6333b8/6332c0 is supported. IRQ mode
+ * and component identification registers fail closed until independently proved.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/host-utils.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "qapi/error.h"
+#include "system/watchdog.h"
+
+#define TYPE_SONY_CP_WDT "sony-cp-wdt"
+#define RESET_WDT (1U << 18)
+OBJECT_DECLARE_SIMPLE_TYPE(SonyCpWdtState, SONY_CP_WDT)
+
+struct SonyCpWdtState {
+    SysBusDevice parent_obj;
+    MemoryRegion regs, scu;
+    QEMUTimer *timer;
+    uint64_t input_hz;
+    int64_t epoch;
+    uint32_t cr, torr, count, reset_bits, output_gate;
+};
+
+static uint32_t wdt_period(unsigned top)
+{
+    return UINT32_C(1) << (16 + top);
+}
+
+static void wdt_reload(SonyCpWdtState *s, unsigned top)
+{
+    uint64_t ns;
+    s->count = wdt_period(top);
+    s->epoch = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    ns = ((uint64_t)s->count * NANOSECONDS_PER_SECOND + s->input_hz - 1) /
+         s->input_hz;
+    timer_mod(s->timer, s->epoch + ns);
+}
+
+static uint32_t wdt_counter(SonyCpWdtState *s)
+{
+    uint64_t elapsed = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->epoch;
+    uint64_t ticks = muldiv64(elapsed, s->input_hz, NANOSECONDS_PER_SECOND);
+    return ticks >= s->count ? 0 : s->count - ticks;
+}
+
+static void wdt_expire(void *opaque)
+{
+    SonyCpWdtState *s = opaque;
+    wdt_reload(s, s->torr & 15);
+    if (s->output_gate & 1) {
+        watchdog_perform_action();
+    }
+}
+
+static void wdt_register_reset(SonyCpWdtState *s)
+{
+    timer_del(s->timer);
+    s->cr = s->torr = s->count = 0;
+}
+
+static void wdt_reset(DeviceState *dev)
+{
+    SonyCpWdtState *s = SONY_CP_WDT(dev);
+    wdt_register_reset(s);
+    s->reset_bits = s->output_gate = 0;
+}
+
+static MemTxResult wdt_read(void *opaque, hwaddr offset, uint64_t *value,
+                            unsigned size, MemTxAttrs attrs)
+{
+    SonyCpWdtState *s = opaque;
+    switch (offset) {
+    case 0: *value = s->cr; break;
+    case 4: *value = s->torr; break;
+    case 8:
+        /* The inactive CCVR reset value has not been observed on this CP. */
+        if (!(s->cr & 1)) {
+            return MEMTX_ERROR;
+        }
+        *value = wdt_counter(s);
+        break;
+    case 0x10: /* Reset mode cannot create an interrupt status. */
+    case 0x14:
+        *value = 0;
+        break;
+    default: return MEMTX_ERROR;
+    }
+    return MEMTX_OK;
+}
+
+static MemTxResult wdt_write(void *opaque, hwaddr offset, uint64_t value,
+                             unsigned size, MemTxAttrs attrs)
+{
+    SonyCpWdtState *s = opaque;
+    if (s->reset_bits & RESET_WDT) {
+        return MEMTX_ERROR;
+    }
+    switch (offset) {
+    case 0:
+        if (value & ~UINT64_C(1)) { /* IRQ/pulse-width modes are not supplied. */
+            return MEMTX_ERROR;
+        }
+        if (!(s->cr & 1) && (value & 1)) {
+            s->cr = 1;
+            wdt_reload(s, (s->torr >> 4) & 15);
+        }
+        /* EN is sticky; only the original SCU reset pulse can disable it. */
+        break;
+    case 4:
+        if (value & ~UINT64_C(0xff)) {
+            return MEMTX_ERROR;
+        }
+        s->torr = value;
+        break;
+    case 0xc:
+        if (!(s->cr & 1)) {
+            return MEMTX_ERROR;
+        }
+        if (value == 0x76) {
+            wdt_reload(s, s->torr & 15);
+        }
+        break;
+    default: return MEMTX_ERROR;
+    }
+    return MEMTX_OK;
+}
+
+static MemTxResult scu_read(void *opaque, hwaddr offset, uint64_t *value,
+                            unsigned size, MemTxAttrs attrs)
+{
+    SonyCpWdtState *s = opaque;
+    switch (offset) {
+    case 0x40: *value = s->reset_bits; break;
+    case 0xa0: *value = s->output_gate; break;
+    default: return MEMTX_ERROR;
+    }
+    return MEMTX_OK;
+}
+
+static MemTxResult scu_write(void *opaque, hwaddr offset, uint64_t value,
+                             unsigned size, MemTxAttrs attrs)
+{
+    SonyCpWdtState *s = opaque;
+    uint32_t next;
+    if (offset == 0xa0) {
+        if (value & ~UINT64_C(1)) {
+            return MEMTX_ERROR;
+        }
+        s->output_gate = value;
+        return MEMTX_OK;
+    }
+    if (value & ~(uint64_t)RESET_WDT) {
+        return MEMTX_ERROR;
+    }
+    switch (offset) {
+    case 0x40: next = value; break;
+    case 0x44: next = s->reset_bits | value; break;
+    case 0x48: next = s->reset_bits & ~value; break;
+    default: return MEMTX_ERROR;
+    }
+    if ((next & RESET_WDT) && !(s->reset_bits & RESET_WDT)) {
+        wdt_register_reset(s);
+    }
+    s->reset_bits = next;
+    return MEMTX_OK;
+}
+
+static const MemoryRegionOps wdt_ops = {
+    .read_with_attrs = wdt_read, .write_with_attrs = wdt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+};
+static const MemoryRegionOps scu_ops = {
+    .read_with_attrs = scu_read, .write_with_attrs = scu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+};
+
+static void wdt_realize(DeviceState *dev, Error **errp)
+{
+    SonyCpWdtState *s = SONY_CP_WDT(dev);
+    SysBusDevice *bus = SYS_BUS_DEVICE(dev);
+    if (!s->input_hz || s->input_hz > NANOSECONDS_PER_SECOND) {
+        error_setg(errp, "sony-cp-wdt input-hz must be in 1..1000000000");
+        return;
+    }
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, wdt_expire, s);
+    memory_region_init_io(&s->regs, OBJECT(dev), &wdt_ops, s,
+                          "sony-cp-wdt-regs", 0x1000);
+    memory_region_init_io(&s->scu, OBJECT(dev), &scu_ops, s,
+                          "sony-cp-wdt-reset", 0x100);
+    sysbus_init_mmio(bus, &s->regs);
+    sysbus_init_mmio(bus, &s->scu);
+}
+
+static const Property wdt_properties[] = {
+    /* Nominal clock from Sony OSS; CP timeout table is consistent, not calibrated. */
+    DEFINE_PROP_UINT64("input-hz", SonyCpWdtState, input_hz, 4000000),
+};
+
+static void wdt_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = wdt_realize;
+    device_class_set_legacy_reset(dc, wdt_reset);
+    device_class_set_props(dc, wdt_properties);
+    dc->desc = "Limited Sony CP reset-mode watchdog";
+    set_bit(DEVICE_CATEGORY_WATCHDOG, dc->categories);
+    /* shortcut: no migration state; add VMState before using a migratable board. */
+}
+
+static const TypeInfo wdt_type = {
+    .name = TYPE_SONY_CP_WDT, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(SonyCpWdtState), .class_init = wdt_class_init,
+};
+static void wdt_register_types(void)
+{
+    type_register_static(&wdt_type);
+}
+type_init(wdt_register_types)
