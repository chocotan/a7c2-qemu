{
  "schema": 1,
  "profile": "ilce7cm2-v201-offline",
  "scope": "Interactive shooting/menu baseline; sensor, lens, capture and storage require separate acceptance",
  "experiment": {
    "stage": "init2",
    "service_profile": "original",
    "seconds": 600,
    "cpus": 4,
    "tcg_thread": "multi",
    "cntfrq": 2000000,
    "gic_boot_shim": true,
    "imaging_service": "release-inhibit",
    "vdf_service": "timecode",
    "system_sound_memory": true,
    "audio_service": "boot",
    "hdmi_service": "boot",
    "audio_capabilities": "inputless",
    "dig_level": "virtual",
    "dmm_service": "unit-size",
    "vef_service": "registry",
    "pinmem_service": "registry",
    "pin_connection": "control",
    "pin_format": "cold",
    "scalar_service": "registry",
    "scalar_connection": "control",
    "adf_service": "registry",
    "adf_connection": "control",
    "hdmi_pin_service": "registry",
    "hdmi_connection": "control",
    "adf_audio_connection": "control",
    "usb_init": "original",
    "usb_platform": "full",
    "usb_controller": "upstream-host",
    "backup_log_profile": "sampled",
    "osd_headless": "on",
    "insmod_policy": "media-rm",
    "native_display": "none",
    "live_frame_seconds": 0.4,
    "gui_models": "capture",
    "remote_state": "capture",
    "gpio_c1": "virtual",
    "bluetooth_policy": "off",
    "stall_seconds": 0,
    "serial_diagnostic_seconds": 120
  }
}
