+/*
+ * Limited direct-RAM eDMA subset from Sony drivers/misc/pciedma/{regs.h,
+ * pcie_dma.c:dma_start}. No LLP, PCIe address remapping, STOP or error subtype
+ * model: unsupported commands fail before accepting a transaction.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/sysbus.h"
+#include "system/address-spaces.h"
+
+#define TYPE_SONY_CP_EDMA "sony-cp-edma"
+#define CHANNELS 8
+#define DIRECTIONS 2
+OBJECT_DECLARE_SIMPLE_TYPE(SonyCpEdma, SONY_CP_EDMA)
+typedef struct EdmaChannel {
+    SonyCpEdma *owner;
+    QEMUTimer *timer;
+    uint32_t reg[9], power;
+    uint64_t src, dst;
+    uint32_t remaining;
+    unsigned direction, channel;
+    bool active;
+} EdmaChannel;
+
+struct SonyCpEdma {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    qemu_irq irq[16];
+    uint32_t enabled[2], pending[2], masked[2], llerr[2];
+    EdmaChannel channels[2][CHANNELS];
+};
+
+static void edma_irqs(SonyCpEdma *s)
+{
+    for (unsigned d = 0; d < DIRECTIONS; d++) {
+        uint32_t active = s->pending[d] & ~s->masked[d];
+        for (unsigned ch = 0; ch < CHANNELS; ch++) {
+            qemu_set_irq(s->irq[d * CHANNELS + ch],
+                         (active & (UINT32_C(0x10001) << ch)) != 0);
+        }
+    }
+}
+
+static bool edma_ram(uint64_t address, uint32_t bytes, bool write)
+{
+    MemoryRegionSection section;
+    bool valid;
+    if (!bytes || address > UINT64_MAX - bytes) {
+        return false;
+    }
+    section = memory_region_find(get_system_memory(), address, bytes);
+    valid = section.mr && memory_region_is_ram(section.mr) &&
+            (!write || !section.readonly) &&
+            section.offset_within_address_space == address &&
+            int128_ge(section.size, int128_make64(bytes));
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
+static void edma_chunk(void *opaque)
+{
+    EdmaChannel *c = opaque;
+    SonyCpEdma *s = c->owner;
+    uint8_t buffer[4096];
+    uint32_t bytes = MIN(c->remaining, sizeof(buffer));
+    MemTxResult result;
+    if (!c->active) {
+        return;
+    }
+    result = address_space_read(&address_space_memory, c->src,
+                                MEMTXATTRS_UNSPECIFIED, buffer, bytes);
+    if (result == MEMTX_OK) {
+        result = address_space_write(&address_space_memory, c->dst,
+                                     MEMTXATTRS_UNSPECIFIED, buffer, bytes);
+    }
+    if (result != MEMTX_OK) {
+        /* A mapping disappearing after preflight is not a successful transfer. */
+        c->active = false;
+        c->reg[0] = (c->reg[0] & ~0x60U) | 0x40;
+        s->pending[c->direction] |= UINT32_C(1) << (16 + c->channel);
+        edma_irqs(s);
+        return;
+    }
+    c->src += bytes;
+    c->dst += bytes;
+    c->remaining -= bytes;
+    c->reg[2] = c->remaining;
+    if (c->remaining) {
+        timer_mod(c->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1);
+    } else {
+        c->active = false;
+        c->reg[0] = (c->reg[0] & ~0x60U) | 0x60;
+        s->pending[c->direction] |= UINT32_C(1) << c->channel;
+        edma_irqs(s);
+    }
+}
+
+static bool edma_start(SonyCpEdma *s, unsigned d, uint64_t doorbell)
+{
+    EdmaChannel *c;
+    uint64_t src, dst;
+    uint32_t size;
+    if (doorbell >= CHANNELS || !s->enabled[d]) {
+        return false;
+    }
+    c = &s->channels[d][doorbell];
+    size = c->reg[2];
+    src = ((uint64_t)c->reg[4] << 32) | c->reg[3];
+    dst = ((uint64_t)c->reg[6] << 32) | c->reg[5];
+    /* Only direct local-interrupt mode. Keep complete high address words. */
+    if (c->active || !c->power || (c->reg[0] & ~0x60U) != 8 || c->reg[1] ||
+        !edma_ram(src, size, false) || !edma_ram(dst, size, true)) {
+        return false;
+    }
+    /* Overlapping buffers have no established hardware ordering contract. */
+    if (src < dst + size && dst < src + size) {
+        return false;
+    }
+    c->src = src;
+    c->dst = dst;
+    c->remaining = size;
+    c->active = true;
+    c->reg[0] = (c->reg[0] & ~0x60U) | 0x20;
+    /* Timing is not calibrated: one virtual ns per bounded4KiB bus operation. */
+    timer_mod(c->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1);
+    return true;
+}
+
+static MemTxResult edma_access(void *opaque, hwaddr offset, uint64_t *value,
+                               bool write)
+{
+    SonyCpEdma *s = opaque;
+    unsigned d, index;
+    uint32_t *field = NULL;
+    EdmaChannel *channel = NULL;
+    for (d = 0; d < DIRECTIONS; d++) {
+        hwaddr base = d ? 0x2c : 0xc;
+        if (offset == base) {
+            field = &s->enabled[d];
+            if (write) {
+                if (*value > 1) {
+                    return MEMTX_ERROR;
+                }
+                for (unsigned ch = 0; ch < CHANNELS; ch++) {
+                    if (s->channels[d][ch].active) {
+                        return MEMTX_ERROR;
+                    }
+                }
+            }
+            goto storage;
+        }
+        if (offset == base + 4) {
+            return write && edma_start(s, d, *value) ? MEMTX_OK : MEMTX_ERROR;
+        }
+        if (offset == (d ? 0xa0 : 0x4c)) {
+            if (write) {
+                return MEMTX_ERROR;
+            }
+            *value = s->pending[d];
+            return MEMTX_OK;
+        }
+        if (offset == (d ? 0xa8 : 0x54)) {
+            field = &s->masked[d];
+            goto storage;
+        }
+        if (offset == (d ? 0xac : 0x58)) {
+            if (!write) {
+                return MEMTX_ERROR;
+            }
+            s->pending[d] &= ~*value;
+            edma_irqs(s);
+            return MEMTX_OK;
+        }
+        if (offset == (d ? 0xc4 : 0x90)) {
+            field = &s->llerr[d];
+            goto storage;
+        }
+        if (offset == (d ? 0xb4 : 0x5c) || (d && offset == 0xb8)) {
+            if (write) {
+                return MEMTX_ERROR;
+            }
+            *value = 0; /* No accepted transfer has a modeled subtype error. */
+            return MEMTX_OK;
+        }
+        base = d ? 0x168 : 0x128;
+        if (offset >= base && offset < base + CHANNELS * 4) {
+            channel = &s->channels[d][(offset - base) / 4];
+            field = &channel->power;
+            if (write && *value > 1) {
+                return MEMTX_ERROR;
+            }
+            goto storage;
+        }
+    }
+    if (offset >= 0x200 && offset < 0x1200) {
+        index = (offset - 0x200) / 0x200;
+        d = ((offset - 0x200) & 0x100) != 0;
+        hwaddr reg = (offset - 0x200) & 0xff;
+        if (reg <= 0x20) {
+            channel = &s->channels[d][index];
+            field = &channel->reg[reg / 4];
+            if (write && reg == 0) {
+                *value = (*value & ~UINT64_C(0x60)) | (channel->reg[0] & 0x60);
+            }
+            if (!write && reg == 8 && channel->active) {
+                *value = channel->remaining;
+                return MEMTX_OK;
+            }
+            goto storage;
+        }
+    }
+    return MEMTX_ERROR;
+storage:
+    if (write) {
+        if (channel && channel->active) {
+            return MEMTX_ERROR;
+        }
+        *field = *value;
+        edma_irqs(s);
+    } else {
+        *value = *field;
+    }
+    return MEMTX_OK;
+}
+
+static MemTxResult edma_read(void *opaque, hwaddr offset, uint64_t *value,
+                             unsigned size, MemTxAttrs attrs)
+{
+    return edma_access(opaque, offset, value, false);
+}
+static MemTxResult edma_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size, MemTxAttrs attrs)
+{
+    return edma_access(opaque, offset, &value, true);
+}
+static const MemoryRegionOps edma_ops = {
+    .read_with_attrs = edma_read, .write_with_attrs = edma_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4, .unaligned = false },
+};
+
+static void edma_reset(DeviceState *dev)
+{
+    SonyCpEdma *s = SONY_CP_EDMA(dev);
+    for (unsigned d = 0; d < DIRECTIONS; d++) {
+        s->enabled[d] = s->pending[d] = s->llerr[d] = 0;
+        s->masked[d] = UINT32_MAX;
+        for (unsigned ch = 0; ch < CHANNELS; ch++) {
+            EdmaChannel *c = &s->channels[d][ch];
+            timer_del(c->timer);
+            memset(c->reg, 0, sizeof(c->reg));
+            c->power = c->remaining = 0;
+            c->active = false;
+        }
+    }
+    edma_irqs(s);
+}
+
+static void edma_realize(DeviceState *dev, Error **errp)
+{
+    SonyCpEdma *s = SONY_CP_EDMA(dev);
+    memory_region_init_io(&s->mmio, OBJECT(dev), &edma_ops, s,
+                          "sony-cp-edma-direct", 0x2000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->mmio);
+    for (unsigned d = 0; d < DIRECTIONS; d++) {
+        for (unsigned ch = 0; ch < CHANNELS; ch++) {
+            EdmaChannel *c = &s->channels[d][ch];
+            c->owner = s;
+            c->direction = d;
+            c->channel = ch;
+            c->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, edma_chunk, c);
+            sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq[d * CHANNELS + ch]);
+        }
+    }
+}
+static void edma_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = edma_realize;
+    device_class_set_legacy_reset(dc, edma_reset);
+    dc->desc = "Limited direct-RAM Sony CP eDMA";
+    /* shortcut: no migration; add VMState before supporting VM save/restore. */
+}
+static const TypeInfo edma_type = {
+    .name = TYPE_SONY_CP_EDMA, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(SonyCpEdma), .class_init = edma_class_init,
+};
+static void edma_register_types(void)
+{
+    type_register_static(&edma_type);
+}
+type_init(edma_register_types)
