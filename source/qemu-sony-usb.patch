+/* Opt-in standard xHCI hardware model for the original platform USB driver. */
+static void create_sony_usb(VirtMachineState *vms)
+{
+    MachineState *ms = MACHINE(vms);
+    DeviceState *dev;
+    SysBusDevice *sbd;
+    const hwaddr base = 0x0b000000;
+    const int irq = 180;
+    const char *node = "/usb@b000000";
+
+    if (!g_strcmp0(g_getenv("QEMU_SONY_USB_NET"), "1")) {
+        dev = qdev_new("sysbus-xhci");
+        qdev_prop_set_uint32(dev, "intrs", 1);
+        qdev_prop_set_uint32(dev, "slots", 8);
+        sbd = SYS_BUS_DEVICE(dev);
+        sysbus_realize_and_unref(sbd, &error_fatal);
+        sysbus_mmio_map(sbd, 0, base);
+        qdev_connect_gpio_out_named(dev, SYSBUS_DEVICE_GPIO_IRQ, 0,
+                                   qdev_get_gpio_in(vms->gic, irq));
+
+        qemu_fdt_add_subnode(ms->fdt, node);
+        qemu_fdt_setprop_string(ms->fdt, node, "compatible", "generic-xhci");
+        qemu_fdt_setprop_sized_cells(ms->fdt, node, "reg", 2, base, 2,
+                                    memory_region_size(sysbus_mmio_get_region(sbd, 0)));
+        qemu_fdt_setprop_cells(ms->fdt, node, "interrupts",
+                              GIC_FDT_IRQ_TYPE_SPI, irq, GIC_FDT_IRQ_FLAGS_LEVEL_HI);
+        qemu_fdt_setprop(ms->fdt, node, "dma-coherent", NULL, 0);
+        qemu_fdt_setprop_string(ms->fdt, node, "status", "okay");
+    }
+}
+
