+/* Local cp-boot-probe change: the CP RTOS probes an ARM GIC at the Sony alias
+ * 0xf13a1000 (GICD_IIDR low 12 bits must read 0x43b). Attach a stock arm_gic
+ * there so the probe resolves. Opt-in and absent from the shared tree. */
+static void cp_attach_gic(MachineState *mch)
+{
+    DeviceState *gic = qdev_new(TYPE_ARM_GIC);
+    SysBusDevice *sbd;
+
+    qdev_prop_set_uint32(gic, "revision", 2);
+    qdev_prop_set_uint32(gic, "num-cpu", mch->smp.cpus);
+    qdev_prop_set_uint32(gic, "num-irq", 512); /* CP descriptor table declares 466 lines */
+    qdev_prop_set_bit(gic, "has-security-extensions", true); /* GIC-400 has TrustZone; without it IGROUPR is RAZ/WI and everything becomes group0 FIQ */
+    qdev_prop_set_bit(gic, "has-virtualization-extensions", false);
+    sbd = SYS_BUS_DEVICE(gic);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, 0xf13a1000);
+    sysbus_mmio_map(sbd, 1, 0xf13a2000);
+    for (int i = 0; i < mch->smp.cpus; i++) {
+        CPUState *cs = qemu_get_cpu(i);
+        sysbus_connect_irq(sbd, i, qdev_get_gpio_in(DEVICE(cs), ARM_CPU_IRQ));
+        sysbus_connect_irq(sbd, mch->smp.cpus + i,
+                           qdev_get_gpio_in(DEVICE(cs), ARM_CPU_FIQ));
+        /* Conditional CP model: original secure-entry path + firmware INTID30.
+         * Sony wiring is not independently verified; never enabled implicitly. */
+        if (g_getenv("QEMU_CP_HYPOTHESIS_SEC_TIMER30")) {
+            qdev_connect_gpio_out(DEVICE(cs), GTIMER_SEC,
+                                  qdev_get_gpio_in(gic, 512 - 32 + i * 32 + 30));
+        }
+    }
+    if (g_getenv("QEMU_CP_TIMERS")) {
+        for (unsigned i = 0; i < 4; i++) {
+            DeviceState *timer = qdev_new("sony-hwtimer");
+            SysBusDevice *timer_bus = SYS_BUS_DEVICE(timer);
+            sysbus_realize_and_unref(timer_bus, &error_fatal);
+            sysbus_mmio_map(timer_bus, 0, 0xf1042000 + i * 0x1000);
+            /* Original CP dis_int/ena_int uses INTID 0x19d + channel. */
+            sysbus_connect_irq(timer_bus, 0,
+                               qdev_get_gpio_in(gic, 0x19d + i - 32));
+        }
+    }
+    if (g_getenv("QEMU_CP_WATCHDOG")) {
+        DeviceState *wdt = qdev_new("sony-cp-wdt");
+        SysBusDevice *wdt_bus = SYS_BUS_DEVICE(wdt);
+        sysbus_realize_and_unref(wdt_bus, &error_fatal);
+        sysbus_mmio_map(wdt_bus, 0, 0xf1052000);
+        sysbus_mmio_map(wdt_bus, 1, 0xf1388300);
+    }
+    if (g_getenv("QEMU_CP_EDMA_GATE")) {
+        DeviceState *gate = qdev_new("sony-cp-edma-gate");
+        SysBusDevice *gate_bus = SYS_BUS_DEVICE(gate);
+        sysbus_realize_and_unref(gate_bus, &error_fatal);
+        sysbus_mmio_map(gate_bus, 0, 0xf11e0274);
+        /* Original CP pcidma_init/ISR table: GIC INTID0x193 (403). */
+        sysbus_connect_irq(gate_bus, 0, qdev_get_gpio_in(gic, 0x193 - 32));
+        if (g_getenv("QEMU_CP_EDMA_DIRECT")) {
+            DeviceState *edma = qdev_new("sony-cp-edma");
+            SysBusDevice *edma_bus = SYS_BUS_DEVICE(edma);
+            sysbus_realize_and_unref(edma_bus, &error_fatal);
+            sysbus_mmio_map(edma_bus, 0, 0xf6780000);
+            for (unsigned i = 0; i < 16; i++) {
+                sysbus_connect_irq(edma_bus, i,
+                                   qdev_get_gpio_in_named(gate, "edma", i));
+            }
+        }
+    }
+}
 
